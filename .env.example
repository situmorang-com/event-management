# Database
DATABASE_URL=file:./data/app.db

# File uploads (use data/uploads so files persist in the same volume as the DB)
UPLOAD_DIR=./data/uploads

# App
APP_URL=http://localhost:5175
NODE_ENV=development

# Google OAuth
# Get credentials from: https://console.cloud.google.com/
# Create Web Application credentials and add authorized redirect URI
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5175/auth/oauth/google/callback

# SMTP (Mailpit defaults for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Event Management <noreply@localhost>

# Production SMTP (Hostinger)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=noreply@transmetatek.com
# SMTP_PASS=your-password
# MAIL_FROM=Event Management <noreply@transmetatek.com>
