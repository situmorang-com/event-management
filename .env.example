# Database
DATABASE_URL=file:./data/app.db

# App
APP_URL=http://localhost:5175
NODE_ENV=development

# SMTP (Mailpit defaults for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Event Management <noreply@localhost>

# Production SMTP (uncomment and configure for production)
# SMTP_HOST=your-smtp-server.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=your-email@domain.com
# SMTP_PASS=your-password
# MAIL_FROM=Event Management <noreply@yourdomain.com>
